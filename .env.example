###############################################################################
# Authentication Providers - ALL DISABLED BY DEFAULT
# Set *_ENABLED=true and fill in the required values to turn them on.
###############################################################################

# ---------------------------------------------------------------------------
# Google OAuth2 (OIDC)
# ---------------------------------------------------------------------------
AUTH_GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_ALLOWED_DOMAINS=example.com

# ---------------------------------------------------------------------------
# Azure AD / Microsoft Entra ID (OIDC)
# ---------------------------------------------------------------------------
AUTH_AZURE_AD_ENABLED=false
AZURE_AD_TENANT_ID=your-tenant-id
AZURE_AD_CLIENT_ID=your-client-id
AZURE_AD_CLIENT_SECRET=your-client-secret
AZURE_AD_REDIRECT_URI=http://localhost:8000/auth/aad/callback
AZURE_AD_ALLOWED_GROUPS=group-id-1,group-id-2

# ---------------------------------------------------------------------------
# Okta OIDC
# ---------------------------------------------------------------------------
AUTH_OKTA_ENABLED=false
OKTA_ISSUER=https://your-domain.okta.com/oauth2/default
OKTA_CLIENT_ID=your-client-id
OKTA_CLIENT_SECRET=your-client-secret
OKTA_REDIRECT_URI=http://localhost:8000/auth/okta/callback
OKTA_ALLOWED_GROUPS=group1,group2

# ---------------------------------------------------------------------------
# Auth0 OIDC
# ---------------------------------------------------------------------------
AUTH_AUTH0_ENABLED=false
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret
AUTH0_REDIRECT_URI=http://localhost:8000/auth/auth0/callback
AUTH0_ALLOWED_EMAILS=user@example.com

# ---------------------------------------------------------------------------
# SAML2 (Azure AD / Okta / ADFS)
# ---------------------------------------------------------------------------
AUTH_SAML_ENABLED=false
SAML_METADATA_URL=https://example.com/federationmetadata.xml
SAML_ENTITY_ID=urn:your-service-provider-entity-id
SAML_ASSERTION_CONSUMER=http://localhost:8000/auth/saml/callback
SAML_ALLOWED_EMAILS=user@example.com,user2@example.com

###############################################################################
# Chatbot & Embedding Configuration
###############################################################################

CHATBOT_WELCOME_MSG="Hi, what is your query today?"

# LLM provider selection: "openai" (default) or "local" (on-prem via OpenAI-compatible server)
LLM_PROVIDER=openai

# OpenAI (cloud) path
LLM_MODEL_OPENAI=gpt-4o-mini
OPENAI_API_KEY=sk-your-openai-key

# Local LLM path (e.g., Ollama or llama.cpp HTTP server)
# If app runs in Docker and LLM runs on host machine, use http://host.docker.internal:11434/v1
LOCAL_LLM_ENDPOINT=http://localhost:11434/v1
# Size selector: small = Llama 3 8B Q4 for low-end; large = Llama 3 70B for high-end
LOCAL_LLM_SIZE=small
LOCAL_LLM_MODEL_SMALL=llama3:8b-instruct-q4_0
LOCAL_LLM_MODEL_LARGE=llama3:70b-instruct

EMBED_STORE_PATH=/data/chroma_store
EMBED_MODE=cpu

# Text embedding models used for QA retrieval.
# Image files are OCR'd and indexed as text.
TEXT_EMBED_MODEL_CPU=all-MiniLM-L6-v2
# Reserved image model setting (not used in current QA retrieval path)
IMAGE_EMBED_MODEL_CPU=clip-ViT-B-32
TEXT_EMBED_MODEL_GPU=all-mpnet-base-v2
# Reserved image model setting (not used in current QA retrieval path)
IMAGE_EMBED_MODEL_GPU=clip-ViT-L-14

# Chunking & retrieval configuration
CHUNK_SIZE_TOKENS=1024
TOP_K_INITIAL=50
TOP_K_RERANKED=5
RERANK_ENABLED=true

# Upload limits
MAX_FILE_SIZE_MB=10
MAX_TOTAL_DOC_SIZE_MB=1024

###############################################################################
# Local Admin (built-in username/password)
###############################################################################

ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Optional bcrypt hash for admin password (takes precedence over ADMIN_PASSWORD)
ADMIN_PASSWORD_HASH=
