###############################################################################
# Authentication Providers - ALL DISABLED BY DEFAULT
# Set *_ENABLED=true and fill in the required values to turn them on.
###############################################################################

# ---------------------------------------------------------------------------
# Google OAuth2 (OIDC)
# ---------------------------------------------------------------------------
AUTH_GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com   # From Google Cloud Console > Credentials
GOOGLE_CLIENT_SECRET=your-google-client-secret                      # From Google Cloud Console > Credentials
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback      # Must match redirect URI in Google config
GOOGLE_ALLOWED_DOMAINS=example.com                                  # Comma-separated allowed email domains for admin (e.g. example.com,example.org)

# ---------------------------------------------------------------------------
# Azure AD / Microsoft Entra ID (OIDC)
# ---------------------------------------------------------------------------
AUTH_AZURE_AD_ENABLED=false
AZURE_AD_TENANT_ID=your-tenant-id                                   # Azure AD Tenant ID (Directory ID)
AZURE_AD_CLIENT_ID=your-client-id                                   # App Registration (Client ID)
AZURE_AD_CLIENT_SECRET=your-secret                                  # Client secret for the app
AZURE_AD_REDIRECT_URI=http://localhost:8000/auth/aad/callback       # Must match redirect URI in Azure app registration
AZURE_AD_ALLOWED_GROUPS=group-id-1,group-id-2                       # Comma-separated Azure AD group object IDs allowed as admin. Leave empty to skip group checks.

# ---------------------------------------------------------------------------
# Okta OIDC
# ---------------------------------------------------------------------------
AUTH_OKTA_ENABLED=false
OKTA_ISSUER=https://your-domain.okta.com/oauth2/default             # Okta issuer URL (Authorization Server)
OKTA_CLIENT_ID=your-client-id
OKTA_CLIENT_SECRET=your-secret
OKTA_REDIRECT_URI=http://localhost:8000/auth/okta/callback          # Must match redirect URI in Okta app config
OKTA_ALLOWED_GROUPS=group1,group2                                   # Comma-separated group names or IDs allowed as admin

# ---------------------------------------------------------------------------
# Auth0 OIDC
# ---------------------------------------------------------------------------
AUTH_AUTH0_ENABLED=false
AUTH0_DOMAIN=your-tenant.auth0.com                                  # Your Auth0 domain
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-secret
AUTH0_REDIRECT_URI=http://localhost:8000/auth/auth0/callback        # Must match redirect URI in Auth0 app config
AUTH0_ALLOWED_EMAILS=user@example.com                               # Comma-separated emails allowed as admin; leave empty to trust all authenticated users.

# ---------------------------------------------------------------------------
# SAML2 (Azure AD / Okta / ADFS)
# NOTE: SAML integration is provided as a reference. You must still configure
# your IdP (Azure AD, Okta, ADFS, etc.) with the SP metadata for this service.
# ---------------------------------------------------------------------------
AUTH_SAML_ENABLED=false
SAML_METADATA_URL=https://example.com/federationmetadata.xml        # IdP metadata URL OR leave empty if you use local XML
SAML_ENTITY_ID=urn:your-service-provider-entity-id                  # SP entity ID registered with IdP
SAML_ASSERTION_CONSUMER=http://localhost:8000/auth/saml/callback    # Assertion Consumer Service (ACS) URL to configure in IdP
SAML_ALLOWED_EMAILS=user@example.com,user2@example.com              # Comma-separated email addresses allowed as admin

###############################################################################
# Chatbot & Embedding Configuration
###############################################################################

# Human-friendly welcome message shown when user opens /chat
CHATBOT_WELCOME_MSG="Hi, what is your query today?"

# OpenAI API key used for RAG synthesis (chat answers)
OPENAI_API_KEY=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

# Path inside container to store ChromaDB persistent index
EMBED_STORE_PATH=/data/chroma_store

# Mode: "cpu" (default) or "gpu" - controls which embedding models are used
EMBED_MODE=cpu

# Text & image embedding models for CPU mode (good for local / low-end machines)
TEXT_EMBED_MODEL_CPU=all-MiniLM-L6-v2
IMAGE_EMBED_MODEL_CPU=clip-ViT-B-32

# Text & image embedding models for GPU mode (heavier but higher quality)
TEXT_EMBED_MODEL_GPU=all-mpnet-base-v2
IMAGE_EMBED_MODEL_GPU=clip-ViT-L-14

# Chunking & retrieval configuration
CHUNK_SIZE_TOKENS=1024           # Max tokens per chunk for token-based chunking
TOP_K_INITIAL=50                 # Number of candidates from vector search before reranking
TOP_K_RERANKED=5                 # Final top-k after reranking
RERANK_ENABLED=true              # Whether cross-encoder reranking step is enabled

# Upload limits
MAX_FILE_SIZE_MB=10              # Maximum size per uploaded file
MAX_TOTAL_DOC_SIZE_MB=1024       # Maximum cumulative size of uploaded docs (in MB)

###############################################################################
# Local Admin (built-in username/password)
###############################################################################

# Fallback admin username
ADMIN_USERNAME=admin

# Initial admin password:
#   - If ADMIN_PASSWORD_HASH is empty and ADMIN_PASSWORD is empty, default is: Strongpassword123#
#   - On first start, the app hashes the password and stores it in /data/admin_hash.txt.
#   - If the hash matches the default password, the app forces password change on first login.
ADMIN_PASSWORD=

# Optional bcrypt hash for admin password (takes precedence over ADMIN_PASSWORD)
# Example of bcrypt hash for "Strongpassword123#": (generate using bcrypt)
ADMIN_PASSWORD_HASH=
